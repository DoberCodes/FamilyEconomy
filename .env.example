VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: persist analytics events to Firestore. Leave off for quieter local/dev use.
VITE_FIRESTORE_ANALYTICS_ENABLED=false

# Optional: public demo login shown on the sign-in screen.
# The reset script uses these values too.
VITE_SHOW_DEMO_LOGIN=true
VITE_DEMO_PARENT_EMAIL=demo@familyeconomy.app
VITE_DEMO_PARENT_PASSWORD=FamilyDemo123!
DEMO_FAMILY_ID=family-demo

# Required for npm run demo:reset when seeding a Firebase demo environment.
# This explicit path is intentional because the script modifies demo/prod data.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional CI alternative for npm run demo:reset.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional fallback context (normally provided by Firebase Auth profile)
VITE_FAMILY_ID=
VITE_USER_ID=
VITE_USER_ROLE=
