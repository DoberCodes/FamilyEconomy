rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function profileDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function familyId() {
      return hasProfile() ? profileDoc().data.familyId : null;
    }

    function isInFamily(targetFamilyId) {
      return hasProfile() && familyId() == targetFamilyId;
    }

    function role() {
      return hasProfile() ? profileDoc().data.role : null;
    }

    function isParent(targetFamilyId) {
      return isInFamily(targetFamilyId) && role() == 'parent';
    }

    function isKid(targetFamilyId) {
      return isInFamily(targetFamilyId) && role() == 'kid';
    }

    function invitePath(inviteCode) {
      return /databases/$(database)/documents/registrationInvites/$(inviteCode);
    }

    function registrationInviteIsUsable(inviteCode) {
      return inviteCode is string
        && exists(invitePath(inviteCode))
        && get(invitePath(inviteCode)).data.active == true
        && get(invitePath(inviteCode)).data.status == 'active'
        && get(invitePath(inviteCode)).data.usedCount < get(invitePath(inviteCode)).data.maxUses
        && request.time < get(invitePath(inviteCode)).data.expiresAt;
    }

    // Users manage only their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'parent'
        && registrationInviteIsUsable(request.resource.data.registrationInviteCode);
      allow update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /registrationInvites/{inviteCode} {
      allow get: if registrationInviteIsUsable(inviteCode);
      allow list: if false;
      allow create, delete: if false;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'usedCount',
          'lastUsedAt',
          'lastUsedBy',
          'updatedAt',
        ])
        && request.resource.data.usedCount == resource.data.usedCount + 1
        && request.resource.data.usedCount <= resource.data.maxUses
        && request.resource.data.lastUsedBy == request.auth.uid;
    }

    match /analyticsEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if hasProfile()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.familyId == familyId();
      allow update, delete: if false;
    }

    match /families/{targetFamilyId} {
      // Family members can read family summary. Only parents can edit family settings.
      allow read: if isInFamily(targetFamilyId);
      allow write: if isParent(targetFamilyId);

      match /jobs/{jobId} {
        // All family members can view jobs.
        allow read: if isInFamily(targetFamilyId);

        // Parents create jobs.
        allow create: if isParent(targetFamilyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.claimedBy == null;

        // Parents can fully update/delete jobs.
        allow update, delete: if isParent(targetFamilyId);

        // Kids can only claim open jobs for themselves.
        allow update: if isKid(targetFamilyId)
          && resource.data.status == 'open'
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.title == resource.data.title
          && request.resource.data.rewardType == resource.data.rewardType
          && request.resource.data.points == resource.data.points
          && request.resource.data.icon == resource.data.icon;
      }

      match /goals/{goalId} {
        allow read: if isInFamily(targetFamilyId);
        allow write: if isParent(targetFamilyId);
      }

      match /rewards/{rewardId} {
        allow read: if isInFamily(targetFamilyId);
        allow write: if isParent(targetFamilyId);
      }

      match /rewardRequests/{requestId} {
        allow read: if isInFamily(targetFamilyId);

        // Kids can create request documents for themselves in pending state.
        allow create: if isKid(targetFamilyId)
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending';

        // Parents can create requests on behalf of child sessions, including auto-approved purchases.
        allow create: if isParent(targetFamilyId)
          && (
            request.resource.data.status == 'pending'
            || (
              request.resource.data.status == 'approved'
              && request.resource.data.requestKind == 'purchase'
              && request.resource.data.autoApproved == true
            )
          );

        // Parents can approve/deny requests and set reviewer metadata.
        allow update, delete: if isParent(targetFamilyId);

        // Kids can respond to a parent counter-offer on their own proposal requests.
        allow update: if isKid(targetFamilyId)
          && resource.data.requestedBy == request.auth.uid
          && resource.data.status == 'countered'
          && resource.data.requestKind == 'proposal'
          && (request.resource.data.status == 'pending' || request.resource.data.status == 'denied');
      }

      match /jobCheckRequests/{requestId} {
        allow read: if isInFamily(targetFamilyId);

        // Kids can create pending check requests for themselves.
        allow create: if isKid(targetFamilyId)
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.childId == request.auth.uid
          && request.resource.data.status == 'pending';

        // Parents can create pending check requests on behalf of child sessions.
        allow create: if isParent(targetFamilyId)
          && request.resource.data.status == 'pending';

        // Parents can review and manage check requests.
        allow update, delete: if isParent(targetFamilyId);
      }

      match /consequenceEvents/{eventId} {
        allow read: if isInFamily(targetFamilyId);
        allow create, update, delete: if isParent(targetFamilyId);
      }

      match /children/{childId} {
        allow read: if isInFamily(targetFamilyId);
        allow write: if isParent(targetFamilyId);
      }

      match /transactions/{transactionId} {
        allow read: if isInFamily(targetFamilyId);
        allow create: if isParent(targetFamilyId);
      }

      match /feedbackEntries/{feedbackId} {
        allow read: if isParent(targetFamilyId);
        allow create: if isParent(targetFamilyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'open';
        allow update, delete: if isParent(targetFamilyId);
      }
    }
  }
}
